# Neon Postgres connection string (pooled). Get it from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Minutes a cached live forecast stays fresh before a re-fetch (on-demand TTL).
FORECAST_TTL_MINUTES=60

# Anthropic API key for the day summary (Haiku 4.5). OPTIONAL: without it the app
# falls back to a deterministic, data-only summary.
ANTHROPIC_API_KEY=

